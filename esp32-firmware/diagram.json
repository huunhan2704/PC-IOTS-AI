{
  "version": 1,
  "author": "Tran Huu Nhan - HCMUNRE",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -30,
      "left": 180,
      "attrs": { "temperature": "28.5", "humidity": "62" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "dust_pot",
      "top": 120,
      "left": 180,
      "attrs": { "value": "15" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:3V3", "dht1:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "dht1:GND", "black", [ "v0" ] ],
    [ "esp:15", "dht1:SDA", "green", [ "v0" ] ],
    [ "esp:3V3", "dust_pot:VCC", "red", [ "v0" ] ],
    [ "esp:GND.2", "dust_pot:GND", "black", [ "v0" ] ],
    [ "esp:34", "dust_pot:SIG", "orange", [ "v0" ] ]
  ],
  "dependencies": {}
}
